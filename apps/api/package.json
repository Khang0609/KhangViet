{
  "name": "api",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir=dist",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test:auth": "wrangler deploy --dry-run --outdir=dist && node test-e2e.mjs",
    "test:fuzz": "schemathesis run http://127.0.0.1:8787/doc --checks all"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@khangviet/data": "workspace:*",
    "@khangviet/repositories": "workspace:*",
    "@khangviet/types": "workspace:*",
    "@scalar/hono-api-reference": "^0.12.16",
    "hono": "^4.13.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "wrangler": "^4.154.0"
  }
}
